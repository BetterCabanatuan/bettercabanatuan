.env.production

# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Lock file (optional - remove this line if you want to commit the lock file)
.terraform.lock.hcl

# Test artifacts
coverage
test-results
playwright-report
blob-report

# QA screenshots from `npm run qa:shots`. Regenerable, and 120 PNGs is a lot of
# noise in a diff — the measurements that matter are committed in
# docs/RESPONSIVE-QA.md and gated by e2e/responsive.spec.ts.
.qa-shots

# Output of the UI review tooling: audit critiques and the JSON findings from
# `npm run qa:shots` / `scripts/qa-audit.mjs`. Regenerable scratch output; the
# decisions that came out of a review are recorded in docs/ and in
# docs/superpowers/specs/ instead.
.impeccable/
